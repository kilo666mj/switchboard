{
  "listen": "127.0.0.1:8090",
  "transport": "http",
  "profile": "infrastructure-read",
  "tool_policy": "infrastructure-read",
  "capability_dir": "capabilities",
  "tool_policies": {
    "infrastructure-read": {
      "version": "example-v1",
      "profile": "infrastructure-read",
      "tools": {
        "rilldns_dns_refresh_status": "allow"
      }
    }
  },
  "egress_policy": {
    "allowed_destinations": ["rilldns.example.com:443"],
    "allowed_cidrs": ["192.0.2.0/24"]
  },
  "profiles": {
    "infrastructure-read": [
      "rilldns"
    ],
    "all": [
      "fleetglass",
      "log_watcher",
      "parallaxd",
      "rendercase",
      "rilldns",
      "taskboard",
      "tintwire",
      "wayminder"
    ],
    "agent-relay": [
      "agent"
    ]
  }
}
