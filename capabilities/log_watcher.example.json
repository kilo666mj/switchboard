{
  "version": 1,
  "type": "module",
  "name": "log_watcher",
  "title": "Log Watcher",
  "tags": ["logs", "alerts", "exclusions"],
  "risk": "mutating",
  "description": "Inspect and manage the centralized log alert filters owned by log_watcher.",
  "command": "/usr/local/libexec/switchboard/switchboard-module-log-watcher",
  "environment": [
    "LOG_WATCHER_API_URL",
    "LOG_WATCHER_API_TOKEN"
  ],
  "enforce_egress_policy": true
}
