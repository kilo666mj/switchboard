# Copy to private.yml (ignored), use deployment-specific URLs, and source all
# credential values from your secret manager. Never commit the populated file.
switchboard_public_origin: https://switchboard.example.com
# Leave empty once all clients use the identity-bound /mcp/sessions endpoint.
# During migration, set a legacy /mcp bearer credential of at least 32 bytes.
switchboard_bearer_token: ""

switchboard_oauth_token_url: https://id.example.com/api/oidc/token

fleetglass_mcp_url: https://fleetglass.example.com/mcp
fleetglass_mcp_token: replace-me
forgejo_mcp_url: https://forgejo-mcp.example.com/mcp
forgejo_mcp_token: "{{ lookup('ansible.builtin.env', 'FORGEJO_MCP_TOKEN') }}"
# Optional local module. When enabled, also add `log_watcher: allow` to the
# selected tool policy and its HTTPS destination to the egress policy.
switchboard_enable_log_watcher: false
# log_watcher_api_url: https://log-watcher-vip.example.com
# log_watcher_api_token: "{{ lookup('ansible.builtin.env', 'LOG_WATCHER_API_TOKEN') }}"
parallaxd_mcp_url: https://status.example.com/mcp
parallaxd_mcp_token: replace-me
rendercase_mcp_url: https://rendercase.example.com/mcp
rendercase_mcp_host: rendercase.example.com
rendercase_oauth_client_id: switchboard
rendercase_oauth_client_secret: "{{ lookup('ansible.builtin.ini', 'SWITCHBOARD_OIDC_CLIENT_SECRET type=properties file=' + playbook_dir + '/oauth.env') }}"
rendercase_oauth_resource: https://rendercase.example.com/mcp
rilldns_mcp_url: https://dns.example.com/mcp
rilldns_mcp_token: replace-me
tintwire_mcp_url: https://tintwire.example.com/mcp
tintwire_oauth_client_id: switchboard
tintwire_oauth_client_secret: "{{ lookup('ansible.builtin.ini', 'SWITCHBOARD_OIDC_CLIENT_SECRET type=properties file=' + playbook_dir + '/oauth.env') }}"
tintwire_oauth_resource: https://tintwire.example.com/mcp
wayminder_mcp_url: https://wayminder.example.com/mcp
wayminder_mcp_token: replace-me
taskboard_mcp_url: https://taskboard.example.com/mcp
taskboard_mcp_token: replace-me

# Optional per-installation clients at /mcp/sessions. Use a different random token
# for every installation. Retain the legacy bearer during a staged migration.
switchboard_clients: {}
switchboard_client_tokens: {}
switchboard_tool_policy: workplace-default
switchboard_tool_policies:
  workplace-default:
    version: example-v1
    profile: all
    capabilities:
      fleetglass: allow
      forgejo: allow
      parallaxd: allow
      rendercase: allow
      rilldns: allow
      taskboard: allow
      tintwire: allow
      wayminder: allow
switchboard_egress_policy:
  allowed_destinations:
    - dns.example.com:443
    - fleetglass.example.com:443
    - forgejo-mcp.example.com:443
    - id.example.com:443
    - rendercase.example.com:443
    - status.example.com:443
    - taskboard.example.com:443
    - tintwire.example.com:443
    - wayminder.example.com:443
  allowed_cidrs:
    - 192.0.2.0/24
switchboard_inbound_oauth: null
switchboard_cloudflare_access: null
# Set only when an in-place upgrade must add or rotate these two values in the
# existing protected environment file. Leave false to preserve them unchanged.
switchboard_update_taskboard_credentials: false
# switchboard_clients:
#   workstation:
#     token_env: SWITCHBOARD_CLIENT_WORKSTATION
#     profile: all
#     tool_policy: workplace-read
#     limits:
#       requests_per_minute: 120
#       burst: 10
#       concurrency: 4
#     discover: true
#     execute: true
#     activate: false
# switchboard_tool_policies:
#   workplace-read:
#     version: pilot-v1
#     profile: all
#     capabilities:
#       fleetglass: allow
#     tools:
#       wayminder_status: allow
#     tool_limits:
#       wayminder_status:
#         requests_per_minute: 60
#         burst: 5
#         concurrency: 2
# switchboard_client_tokens:
#   SWITCHBOARD_CLIENT_WORKSTATION: generate-a-unique-random-token

# Mandatory egress boundary. List every capability and identity-provider
# destination using exact host:port syntax and only the networks they may resolve
# into. HTTPS and normal certificate verification are mandatory.
# Use empty destination and CIDR lists only for an intentional deny-all gateway.

# Prometheus integration used by monitoring.yml. The target must resolve from
# the monitoring host. Keep TLS verification enabled with a valid internal CA.
# switchboard_metrics_target: switchboard.example.com
# switchboard_metrics_scheme: https
# switchboard_metrics_tls_insecure_skip_verify: false
# switchboard_prometheus_container: prometheus

# OAuth resource-server authentication for /mcp/sessions. Configure a matching
# API resource and permissions in the authorization server. Static clients are
# disabled by default when this block is present.
# switchboard_inbound_oauth:
#   issuer: https://id.example.com
#   resource: https://switchboard.example.com/mcp/sessions
#   required_scopes:
#     - openid # required when group_source is userinfo
#     - mcp:connect
#   group_claim: groups
#   group_source: access_token # use userinfo for Pocket ID group claims
#   scope_claim: scope
#   jwt_type: at+jwt
#   static_client_allowlist:
#     - workload-agent
#   policy_mode: exclusive # use composed for additive group entitlements
#   policies:
#     workplace-readers:
#       version: pilot-v1
#       groups:
#         - switchboard-readers
#       required_scopes:
#         - tools:read
#       profile: all
#       tool_policy: workplace-read
#       discover: true
#       execute: true
#       activate: false

# Optional Cloudflare Access identity source for an Access-protected ingress.
# The origin must be reachable only through the matching Access application.
# OAuth and Cloudflare Access policies may reference the same profile and tool
# policy. Both assertions on one request are rejected as ambiguous.
# switchboard_cloudflare_access:
#   team_domain: https://example.cloudflareaccess.com
#   audience: replace-with-the-access-application-aud-tag
#   static_client_allowlist:
#     - workload-agent
#   policy_mode: exclusive # use composed for additive group entitlements
#   policies:
#     workplace-users:
#       version: pilot-v1
#       groups:
#         - switchboard-users
#       profile: all
#       tool_policy: workplace-read
#       discover: true
#       execute: true
#       activate: false
